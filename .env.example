# Anastasia Sensual Massage — Environment Variables
# Copy this file to .env.local and fill in your values.

# Site URL (no trailing slash)
# Production: https://www.anamassage4u.co.uk
NEXT_PUBLIC_SITE_URL=https://www.anamassage4u.co.uk

# Search-engine ownership verification (optional).
# Google Search Console → Settings → Ownership verification → HTML tag → copy only the content="..." value.
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag → copy only the content="..." value.
# BING_SITE_VERIFICATION=
