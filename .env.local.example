# ─────────────────────────────────────────────────────────────
# Anastasia Massage — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# Site URL (no trailing slash)
# Development: http://localhost:3000
# Production:  https://yourdomain.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Booking Form Emails ────────────────────────────────────
# Get your API key from: https://resend.com
# If left empty, booking submissions are logged to console only.
RESEND_API_KEY=

# The email address that receives booking requests
CONTACT_EMAIL=hello@anastassiamassage.co.uk
